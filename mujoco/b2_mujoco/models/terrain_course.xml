<mujoco model="wego terrain course">
  <!-- Angles are radians because b2.xml sets the shared compiler convention. -->
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-20"/>
  </visual>

  <asset>
    <texture name="course_skybox" type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.08" width="512" height="512"/>
    <material name="course_ground" rgba="0.35 0.38 0.35 1"/>
    <material name="course_hill" rgba="0.45 0.32 0.18 1"/>
    <material name="course_obstacle" rgba="0.65 0.35 0.15 1"/>
    <material name="course_wall" rgba="0.45 0.48 0.52 1"/>
  </asset>

  <default>
    <default class="course">
      <geom group="0" condim="3" mass="0" density="0" friction="0.9 0.005 0.0001"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 12" dir="0 0 -1" directional="true"/>

    <geom name="course_ground" type="plane" size="16 8 0.1"
          material="course_ground" friction="1.2 0.01 0.001" class="course"/>

    <!-- Two 15-degree ramps. Their top edges meet at the crest, and the lower
         top edges are flush with the ground plane (angles are radians). -->
    <geom name="hill_up" type="box" size="3.15 2.2 0.15" pos="-5.0 0 0.669"
          euler="0 -0.261799388 0" material="course_hill"
          friction="1.3 0.01 0.001" class="course"/>
    <geom name="hill_down" type="box" size="3.15 2.2 0.15" pos="1.0 0 0.669"
          euler="0 0.261799388 0" material="course_hill"
          friction="1.3 0.01 0.001" class="course"/>

    <geom name="bump_1" type="cylinder" size="0.45 0.12" pos="5.0 -1.2 0.06"
          material="course_obstacle" class="course"/>
    <geom name="bump_2" type="cylinder" size="0.55 0.16" pos="6.2 0.2 0.08"
          material="course_obstacle" class="course"/>
    <geom name="bump_3" type="cylinder" size="0.40 0.10" pos="7.4 1.3 0.05"
          material="course_obstacle" class="course"/>
    <geom name="bump_4" type="cylinder" size="0.50 0.14" pos="8.0 -1.5 0.07"
          material="course_obstacle" class="course"/>

    <geom name="obstacle_box_1" type="box" size="0.45 0.45 0.25" pos="5.5 2.6 0.25"
          material="course_obstacle" class="course"/>
    <geom name="obstacle_box_2" type="box" size="0.65 0.35 0.40" pos="7.5 2.7 0.40"
          material="course_obstacle" class="course"/>
    <geom name="obstacle_box_3" type="box" size="0.35 0.70 0.30" pos="9.0 0.0 0.30"
          material="course_obstacle" class="course"/>
    <geom name="curb" type="box" size="1.8 0.18 0.12" pos="10.0 -2.0 0.12"
          euler="0 0 0.261799388" material="course_obstacle" class="course"/>

    <geom name="wall_left" type="box" size="15.0 0.12 0.75" pos="0 5.0 0.75"
          material="course_wall" class="course"/>
    <geom name="wall_right" type="box" size="15.0 0.12 0.75" pos="0 -5.0 0.75"
          material="course_wall" class="course"/>
    <geom name="wall_back" type="box" size="0.12 5.0 0.75" pos="-15.0 0 0.75"
          material="course_wall" class="course"/>
    <geom name="wall_front" type="box" size="0.12 5.0 0.75" pos="15.0 0 0.75"
          material="course_wall" class="course"/>
    <geom name="internal_wall" type="box" size="0.15 1.8 0.65" pos="10.5 1.5 0.65"
          euler="0 0 0.34906585" material="course_wall" class="course"/>
  </worldbody>
</mujoco>
