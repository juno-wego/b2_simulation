<mujoco model="b2 arm nav scene">
  <!-- B2 carrying a FAIRINO FR3.  b2_arm.xml is generated from b2.xml by
       rl_training/tools/make_b2_arm_asset.py, the same script that generates the
       training asset, so the payload the policy trained against and the payload
       it is validated against are the same 21.5 kg.

       Run it with:
         ros2 launch b2_mujoco b2_sim.launch.py \
             scene_file:=<share>/models/b2_arm_nav_scene.xml \
             policy_file:=<share>/policy/b2_arm_velocity.onnx -->
  <include file="b2_arm.xml"/>
  <include file="nav_world.xml"/>

  <keyframe>
    <!-- Nominal stand: the pose B2's FixStand FSM holds before handing off to the
         RL policy, so the policy's first action is a no-op. -->
    <key name="stand"
      qpos="0 0 0.5435 1 0 0 0
            0 0.8 -1.5  0 0.8 -1.5  0 0.8 -1.5  0 0.8 -1.5"/>
  </keyframe>
</mujoco>
